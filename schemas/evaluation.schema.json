{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-mirror:evaluation:am-0.2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewedEvidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "id",
              "reason"
            ]
          }
        },
        "taskFamiliesFinalized": {
          "type": "boolean"
        },
        "counterexampleSearchComplete": {
          "type": "boolean"
        }
      },
      "required": [
        "reviewedEvidence",
        "excludedEvidence",
        "taskFamiliesFinalized",
        "counterexampleSearchComplete"
      ]
    },
    "priorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "maxLength": 2000
          },
          "verify": {
            "type": "string",
            "maxLength": 2000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@|/#=-]{0,255}$"
            }
          }
        },
        "required": [
          "action",
          "verify",
          "evidence"
        ]
      },
      "minItems": 2,
      "maxItems": 3
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "behavior": {
                  "type": "string"
                },
                "result": {
                  "type": "string"
                },
                "verification": {
                  "type": "string"
                },
                "enactment": {
                  "enum": [
                    "decision",
                    "action",
                    "request-only"
                  ]
                },
                "outcome": {
                  "enum": [
                    "verified",
                    "failure",
                    "claim-only"
                  ]
                },
                "attribution": {
                  "enum": [
                    "human",
                    "agent",
                    "unknown"
                  ]
                },
                "verificationMethod": {
                  "enum": [
                    "human-followup",
                    "independent-artifact"
                  ]
                },
                "scope": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "behavior",
                "result",
                "verification",
                "enactment",
                "outcome",
                "attribution",
                "verificationMethod",
                "scope"
              ]
            }
          },
          "counterReview": {
            "type": "string",
            "maxLength": 2000
          },
          "uncertainty": {
            "type": "string",
            "maxLength": 2000
          },
          "nextLevelGap": {
            "type": "string",
            "maxLength": 2000
          },
          "conflict": {
            "enum": [
              "none-found",
              "resolved",
              "unresolved"
            ]
          },
          "improvement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string",
                "maxLength": 2000
              },
              "verify": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "action",
              "verify"
            ]
          },
          "axis": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "indicator": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "value": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              {
                "type": "null"
              }
            ]
          },
          "quality": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "support": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@|/#=-]{0,255}$"
            }
          },
          "counterexamples": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@|/#=-]{0,255}$"
            }
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000
          },
          "humanContribution": {
            "type": "string",
            "maxLength": 2000
          },
          "agentActivity": {
            "type": "string",
            "maxLength": 2000
          },
          "outcome": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "observations",
          "counterReview",
          "uncertainty",
          "nextLevelGap",
          "conflict",
          "improvement",
          "axis",
          "indicator",
          "value",
          "quality",
          "support",
          "counterexamples",
          "rationale",
          "humanContribution",
          "agentActivity",
          "outcome"
        ]
      },
      "minItems": 24,
      "maxItems": 24
    },
    "taskGroups": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 64
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strengths": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 12
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 12
        },
        "workPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 12
        },
        "lifePatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 12
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 12
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 12
        }
      },
      "required": [
        "strengths",
        "gaps",
        "workPatterns",
        "lifePatterns",
        "actions",
        "limitations"
      ]
    }
  },
  "required": [
    "decisions",
    "narrative",
    "priorities",
    "review"
  ]
}
